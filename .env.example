# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API. Both of these are safe to ship to the browser:
# the anon key is designed to be public and is useless without a JWT that RLS
# will scope to the caller's shop.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or anywhere under src/.
# It bypasses row-level security completely.

# ── Feature flags ─────────────────────────────────────────────────────────────
# Phone OTP sign-in. Needs a contracted SMS provider (Twilio / MessageBird)
# configured in Supabase Auth first, so it ships off.
VITE_ENABLE_PHONE_OTP=false

# Seed the starter catalogue (~60 common grocery items) on shop creation.
VITE_SEED_STARTER_CATALOG=true
